# ---------------------------------------------------------------------------
# HiggsStudio · configuración
#
# TODO es opcional. Sin ninguna clave la app funciona en modo demostración:
# genera el material en local con ffmpeg, gratis y sin salir a internet.
# En cuanto pongas una clave, esa parte pasa a usar modelos reales.
# ---------------------------------------------------------------------------

# --- Proveedores de generación --------------------------------------------
# auto = elige el primero con clave; o fija fal | replicate | openai | local
VIDEO_PROVIDER=auto
IMAGE_PROVIDER=auto
AUDIO_PROVIDER=auto

# fal.ai: el más completo para vídeo (Kling, Veo, Sora, Wan, Seedance…).
# https://fal.ai/dashboard/keys
FAL_API_KEY=

# Replicate: alternativa con catálogo parecido.
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# OpenAI: solo para imagen (gpt-image).
OPENAI_API_KEY=

# ElevenLabs: voz, música, efectos, doblaje y clonado de voces.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Anthropic: mejora los prompts y escribe los guiones de los anuncios.
# Sin esta clave se usan heurísticas locales, que funcionan razonablemente.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Cola de trabajos ------------------------------------------------------
JOB_CONCURRENCY=2
JOB_TIMEOUT_S=1800

# --- Créditos --------------------------------------------------------------
SIGNUP_CREDITS=600
# Sube esto si quieres cobrar más caro cada generación (1.0 = tarifa base).
CREDIT_MULTIPLIER=1.0

# --- Cuentas y seguridad ---------------------------------------------------
# Si publicas la app en internet, pon ALLOW_SIGNUP=false o un INVITE_CODE:
# si no, cualquiera con la URL puede registrarse y gastar tus claves.
ALLOW_SIGNUP=true
INVITE_CODE=
# Primera cuenta (administradora) al arrancar con la base vacía.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
SESSION_DAYS=30
# ¿Se ve la galería sin iniciar sesión?
PUBLIC_EXPLORE=true

# --- Almacenamiento y servidor --------------------------------------------
MAX_UPLOAD_MB=2048
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
