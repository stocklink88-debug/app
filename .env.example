# ---------------------------------------------------------------------------
# ViralClips — configuración
# Copia este archivo a .env y rellena lo que vayas a usar.
# Todo es opcional: sin ninguna clave la app funciona, pero con menos calidad.
# ---------------------------------------------------------------------------

# --- Transcripción (elige UNA opción) --------------------------------------
# auto | groq | openai | faster_whisper | energy
TRANSCRIBE_PROVIDER=auto

# Opción A: Groq. La más barata y rápida (~0,07 $/hora de vídeo).
#   Clave en https://console.groq.com/keys
GROQ_API_KEY=

# Opción B: OpenAI (~0,36 $/hora de vídeo).
#   Clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Opción C: local y gratis. Requiere `pip install faster-whisper`.
#   Modelos: tiny, base, small, medium, large-v3 (más grande = mejor y más lento)
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_COMPUTE_TYPE=int8

# --- Selección de momentos virales ------------------------------------------
# Sin clave se usa sólo la heurística (gratis y decente).
# Con clave, Claude elige los fragmentos y escribe títulos, copys y hashtags.
#   Clave en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Peso de Claude frente a la heurística al combinar notas (0 = sólo heurística).
LLM_WEIGHT=0.65

# --- Servidor ---------------------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=4096
JOB_CONCURRENCY=1          # vídeos procesados a la vez
RENDER_CONCURRENCY=2       # clips montados en paralelo (sube si tienes CPU)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fuente de los subtítulos. Debe estar instalada en el sistema;
# si no, libass usa la que encuentre (`fc-list` lista las disponibles).
SUBTITLE_FONT=Inter Display

# Contraseña de acceso. Déjala vacía en local.
# OBLIGATORIA si publicas la app en internet: sin ella, cualquiera con la URL
# puede subir vídeos y gastar tus créditos de API.
ACCESS_PASSWORD=
